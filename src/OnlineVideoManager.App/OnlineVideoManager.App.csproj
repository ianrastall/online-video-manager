<Project Sdk="Microsoft.NET.Sdk">
  <!-- Self-contained WinUI payload. scripts/Package.ps1 wraps this output in a signed MSIX. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>OnlineVideoManager.App</RootNamespace>
    <AssemblyName>OnlineVideoManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnlineVideoManager.Core\OnlineVideoManager.Core.csproj" />
    <ProjectReference Include="..\OnlineVideoManager.ViewModels\OnlineVideoManager.ViewModels.csproj" />
    <ProjectReference Include="..\OnlineVideoManager.Interop\OnlineVideoManager.Interop.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\artifacts\native\ovm_core.dll')">
    <Content Include="..\..\artifacts\native\ovm_core.dll" Link="ovm_core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The SDK's unpackaged publish does not carry the app's compiled XAML/PRI by default. -->
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_WinUIResource Include="$(TargetDir)**\*.xbf;$(TargetDir)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="@(_WinUIResource)">
        <RelativePath>%(_WinUIResource.RecursiveDir)%(_WinUIResource.Filename)%(_WinUIResource.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
