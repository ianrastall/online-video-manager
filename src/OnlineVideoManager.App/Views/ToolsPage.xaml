<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OnlineVideoManager.App.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OnlineVideoManager.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="16,12,16,24" Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Tools" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="yt-dlp does the downloading. Deno lets it handle YouTube's player checks, and ffmpeg merges and converts the result. All three come from their official releases and are checked against the published SHA-256 before installing." />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True">
                        <Run Text="Folder: " />
                        <Run Text="{x:Bind ViewModel.ToolsDirectory, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Command="{x:Bind ViewModel.CheckForUpdatesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Check for updates" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.UpdateAllCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock Text="Install or update all" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.OpenToolsFolderCommand}" ToolTipService.ToolTip="Open the tools folder">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Tools}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolItemViewModel">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Description}" />
                                    <TextBlock Margin="0,6,0,0" IsTextSelectionEnabled="True">
                                        <Run Text="Installed: " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Run Text="{x:Bind InstalledText, Mode=OneWay}" />
                                        <Run Text="     Latest: " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Run Text="{x:Bind LatestText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Detail, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind StatusText, Mode=OneWay}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    MinWidth="96"
                                    VerticalAlignment="Center"
                                    Content="{x:Bind ActionText, Mode=OneWay}"
                                    Command="{x:Bind InstallCommand}" />

                                <ProgressBar
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Maximum="100"
                                    Value="{x:Bind ProgressValue, Mode=OneWay}"
                                    IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                    Visibility="{x:Bind IsWorking, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Activity" />
            <Border Style="{StaticResource CardStyle}" MinHeight="80">
                <ItemsControl ItemsSource="{x:Bind ViewModel.LogLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Style="{StaticResource LogTextStyle}" Text="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
