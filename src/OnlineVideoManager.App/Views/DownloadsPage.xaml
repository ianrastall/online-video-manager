<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OnlineVideoManager.App.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OnlineVideoManager.App"
    xmlns:vm="using:OnlineVideoManager.ViewModels"
    NavigationCacheMode="Required">

    <!-- Transparent background so drops land anywhere on the page, not only on controls. -->
    <Grid
        Padding="16,12,16,16"
        RowSpacing="12"
        AllowDrop="True"
        Background="Transparent"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Add links -->
        <Border Style="{StaticResource CardStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox
                    MinHeight="72"
                    MaxHeight="180"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    PlaceholderText="Paste or type one or more links. One per line, or separated by spaces. Text around them is ignored."
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddFromInputCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add to queue" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.AddFromClipboardCommand}" ToolTipService.ToolTip="Queue every link that is on the clipboard right now">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE77F;" FontSize="14" />
                                <TextBlock Text="Add from clipboard" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.ImportFileCommand}" ToolTipService.ToolTip="Queue every link in a text file">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="Import text file" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind ViewModel.InputSummary, Mode=OneWay}" />

                    <ToggleSwitch
                        Grid.Column="2"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent="Video"
                        OnContent="Audio only"
                        ToolTipService.ToolTip="What new links are downloaded as"
                        IsOn="{x:Bind ViewModel.AddAsAudio, Mode=TwoWay}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Clipboard inbox -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE77F;" FontSize="18" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Clipboard" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Inbox.Summary, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ToggleSwitch
                            MinWidth="0"
                            OffContent="Not watching"
                            OnContent="Watching"
                            ToolTipService.ToolTip="Collect video links whenever you copy them in any app"
                            IsOn="{x:Bind Inbox.IsWatching, Mode=TwoWay}" />
                        <Button Command="{x:Bind Inbox.ScanHistoryCommand}" ToolTipService.ToolTip="Collect video links from Windows clipboard history (Win+V)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE81C;" FontSize="14" />
                                <TextBlock Text="Scan clipboard history" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" RowSpacing="8" Visibility="{x:Bind Inbox.HasLinks, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView
                        MaxHeight="220"
                        SelectionMode="None"
                        ItemsSource="{x:Bind Inbox.Links}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="Padding" Value="4,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CollectedLinkViewModel">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Url}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Url}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="{x:Bind Host}" />
                                    <Button
                                        Grid.Column="3"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{x:Bind RemoveCommand}"
                                        ToolTipService.ToolTip="Remove from this list">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Inbox.AddSelectedCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add ticked to queue" />
                            </StackPanel>
                        </Button>
                        <Button Content="Tick all / none" Command="{x:Bind Inbox.SelectAllCommand}" />
                        <Button Content="Clear list" Command="{x:Bind Inbox.ClearCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Queue header -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Queue" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.QueueSummary, Mode=OneWay}" />
            </StackPanel>

            <CommandBar
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsOpen="False">
                <AppBarButton Label="{x:Bind ViewModel.QueueToggleText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleQueueCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="{x:Bind ViewModel.QueueToggleGlyph, Mode=OneWay}" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Retry failed" Command="{x:Bind ViewModel.RetryFailedCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Clear finished" Command="{x:Bind ViewModel.ClearFinishedCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Open folder" Command="{x:Bind ViewModel.OpenOutputFolderCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Cancel all" Command="{x:Bind ViewModel.CancelAllCommand}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE711;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- Queue -->
        <Grid Grid.Row="3">
            <TextBlock
                Margin="0,24"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                TextAlignment="Center"
                Text="Nothing queued. Paste links above, add them from the clipboard, import a text file, or drag links onto this window."
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

            <ListView SelectionMode="None" ItemsSource="{x:Bind ViewModel.Items}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadItemViewModel">
                        <Border Style="{StaticResource CardStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <FontIcon
                                    Grid.RowSpan="2"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Glyph="{x:Bind ModeGlyph}"
                                    ToolTipService.ToolTip="{x:Bind ModeText}" />

                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Url}" />

                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{x:Bind StatusText, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{x:Bind Host}" />
                                    <Run Text="  " />
                                    <Run Text="{x:Bind DetailText, Mode=OneWay}" />
                                </TextBlock>

                                <StackPanel Grid.RowSpan="2" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{x:Bind OpenFileCommand}"
                                        ToolTipService.ToolTip="Open the file"
                                        Visibility="{x:Bind HasFile, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    </Button>
                                    <Button
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{x:Bind RetryCommand}"
                                        ToolTipService.ToolTip="Download again"
                                        Visibility="{x:Bind CanRetry, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </Button>
                                    <Button
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{x:Bind CancelCommand}"
                                        ToolTipService.ToolTip="Cancel"
                                        Visibility="{x:Bind CanCancel, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="More">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Show in folder" Command="{x:Bind RevealFileCommand}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE838;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Show or hide log" Command="{x:Bind ToggleLogCommand}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8A5;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copy link" Command="{x:Bind CopyUrlCommand}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C8;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Remove from queue" Command="{x:Bind RemoveCommand}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>

                                <ProgressBar
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Maximum="100"
                                    Value="{x:Bind ProgressValue, Mode=OneWay}"
                                    IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                    Visibility="{x:Bind ShowProgress, Mode=OneWay}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasError, Mode=OneWay}" />

                                <Border
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    MaxHeight="200"
                                    Padding="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Visibility="{x:Bind IsLogVisible, Mode=OneWay}">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{x:Bind LogLines, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Style="{StaticResource LogTextStyle}" Text="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
